# Supabase — set these in .env.local (gitignored) and in Vercel env vars
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Data store switch: json (file-based, ephemeral on Vercel) | supabase (persistent)
DATA_STORE=json

# Protects /api/scrape cron endpoint — set a random secret and configure Vercel Cron Authorization header
CRON_SECRET=change_me_to_a_random_secret
